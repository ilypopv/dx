{
  "name": "dx",
  "displayName": "dx",
  "description": "View PDF, DOCX and DOC files in VS Code; annotate PDFs and edit the text of DOCX documents.",
  "version": "1.1.1",
  "publisher": "ilypopv",
  "icon": "img/icon.png",
  "author": {
    "name": "Ilya Popov",
    "url": "https://github.com/ilypopv"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/vs-office/dx.git"
  },
  "bugs": {
    "url": "https://github.com/vs-office/dx/issues"
  },
  "homepage": "https://github.com/vs-office/dx#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "PDF",
    "DOCX",
    "DOC",
    "Word",
    "viewer",
    "vscode"
  ],
  "activationEvents": [
    "onCommand:pdf.preview",
    "onCommand:word.preview",
    "onLanguage:pdf",
    "onLanguage:docx",
    "onLanguage:doc",
    "onCustomEditor:dx-pdf-editor",
    "onCustomEditor:dx-docx-editor",
    "onCustomEditor:dx-doc-editor"
  ],
  "main": "./dist/extension",
  "browser": "./dist/extension",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [
      {
        "id": "pdf",
        "extensions": [
          ".pdf"
        ],
        "aliases": [
          "PDF"
        ]
      },
      {
        "id": "docx",
        "extensions": [
          ".docx"
        ],
        "aliases": [
          "Word"
        ]
      },
      {
        "id": "doc",
        "extensions": [
          ".doc"
        ],
        "aliases": [
          "Word 97-2003"
        ]
      }
    ],
    "commands": [
      {
        "command": "pdf.preview",
        "category": "PDF",
        "title": "Open Preview"
      },
      {
        "command": "word.preview",
        "category": "Word",
        "title": "Open Preview"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceLangId == pdf",
          "command": "pdf.preview",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == docx",
          "command": "word.preview",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == doc",
          "command": "word.preview",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "when": "resourceLangId == pdf",
          "command": "pdf.preview",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == docx",
          "command": "word.preview",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == doc",
          "command": "word.preview",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "pdf.preview",
          "when": "false"
        },
        {
          "command": "word.preview",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "dx-pdf-editor",
        "displayName": "PDF Editor",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ]
      },
      {
        "viewType": "dx-docx-editor",
        "displayName": "Word Editor",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ]
      },
      {
        "viewType": "dx-doc-editor",
        "displayName": "Word 97-2003 Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.doc"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run vendor && webpack --mode production",
    "compile": "npm run vendor && webpack --mode none",
    "watch": "npm run vendor && webpack --mode none --watch",
    "vendor": "node scripts/vendor.js",
    "package": "vsce package --no-dependencies -o dx.vsix",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:e2e": "npm run compile && node test/e2e/run.js",
    "parity": "node scripts/parity.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.90.0",
    "@types/webpack-env": "^1.18.8",
    "@vscode/vsce": "^3.0.0",
    "assert": "^2.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "process": "^0.11.10",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.52.1",
    "webpack-cli": "^4.8.0"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "path-browserify": "^1.0.1",
    "vscode-uri": "^3.0.2"
  }
}
